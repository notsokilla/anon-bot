# BOT_TOKEN — токен бота от @BotFather
BOT_TOKEN=

# ADMIN_IDS — Telegram ID администраторов (через пробел или запятую)
ADMIN_IDS=

# ADMIN_PASSWORD — пароль для входа в админку по команде /admin
ADMIN_PASSWORD=

# PROXY_URL — прокси (опционально), например: socks5://user:pass@host:port
PROXY_URL=
PROXY_USER=
PROXY_PASSWORD=

# DATABASE_URL — URL базы данных (по умолчанию SQLite)
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db

# LANDING_URL — ссылка на лендинг для оплаты/раскрытия анонима
LANDING_URL=https://example.com/reveal

# TOKEN_SECRET — секрет для генерации токенов
TOKEN_SECRET=change_me

# WEBHOOK_PORT — порт для вебхука оплаты (для локалки и сервера)
WEBHOOK_PORT=8080

# SCHEDULED_BROADCAST_CRON — расписание рассылки (cron формат, опционально)
# Пример: "0 12 * * *" — каждый день в 12:00 UTC
SCHEDULED_BROADCAST_CRON=

# SCHEDULED_BROADCAST_TEXT — текст запланированной рассылки (опционально)
SCHEDULED_BROADCAST_TEXT=
